# ─────────────────────────────────────────────────────────────────────────────
# 2026 Abeokuta Polo Festival — environment contract (NAMES ONLY, never values)
# Copy to .env.local for local development; set the same names in Vercel.
# Reference: ARCHITECTURE_PLAN.md §15.
#
# SECURITY: values that appeared in stitch_.../the_blueprint.txt (Supabase
# service-role key, DB password, Gmail app password, CRON_SECRET,
# WORKER_AUTH_SECRET, ENCRYPTION_SECRET) MUST be rotated before any deploy.
# Blank values are treated as "not set".
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin (canonical URL, sitemap/OG, Paystack return URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — browser (anon, RLS-scoped)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# QR credential signing (HMAC-SHA256; tokens stored as hashes only)
QR_SIGNING_SECRET=

# Encryption for sensitive PII at rest (bank details, private notes)
ENCRYPTION_SECRET=

# Cron + worker auth (internal endpoints only)
CRON_SECRET=
WORKER_AUTH_SECRET=

# Email delivery (EmailBump) — transactional invitations, pass dispatch
EMAILBUMP_API_KEY=
EMAILBUMP_PROJECT_ID=
EMAILBUMP_SMTP_HOST=smtp.emailbump.com
EMAILBUMP_SMTP_PORT=587
EMAILBUMP_SMTP_PASSWORD=
EMAIL_FROM=tickets@abeokutapolofestival.com
RESEND_API_KEY=

# ── Day 3 VVIP pass (ARCHITECTURE_PLAN.md D-16) ──────────────────────────────
# Paystack SECRET key (sk_live_… / sk_test_…). Server only — never NEXT_PUBLIC_.
# REQUIRED in production: without it, Day 3 payments are refused (no simulation).
# In local development, leaving it blank enables simulated payments.
# In production/preview environments, setting PAYSTACK_DEMO_MODE=true enables simulated payments when keys are absent.
PAYSTACK_SECRET_KEY=
PAYSTACK_DEMO_MODE=false

# Special Invitation Codes for complimentary Day 3 VVIP passes — comma-separated,
# each at least 6 characters, one pass per code. Server only. Empty = no code works.
# Example format: VVIP_INVITATION_CODES=CODE-ONE,CODE-TWO
VVIP_INVITATION_CODES=

# Feature flags (string "true"/"false")
NEXT_PUBLIC_FEATURE_HOSPITALITY_ENQUIRY=true

# Live RLS allow/deny tests (tests/unit/rls-live.test.ts) — scratch project ONLY.
# Leave empty locally; the suite skips itself.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=
SUPABASE_TEST_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NOT USED BY THIS PRODUCT (documented on purpose — D-01/D-16):
#   FLUTTERWAVE_SECRET_KEY, STRIPE_SECRET_KEY, …
# The ONLY paid product is the Day 3 VVIP pass, through Paystack (above).
# Days 1–2 are free; hospitality and sponsorship are settled offline.
# Do not add other gateway keys.
# ─────────────────────────────────────────────────────────────────────────────
